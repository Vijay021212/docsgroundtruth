# Copy this file to `.env` and change what you need for your machine.
# Every setting is optional: anything not set here falls back to the defaults
# in src/docsgroundtruth/config.py.
# All variables share the DGT_ prefix (DocsGroundTruth) so they never clash
# with other tools' settings.

# --- Ollama (local model server) ---
DGT_OLLAMA_HOST=http://localhost:11434
DGT_EMBED_MODEL=nomic-embed-text
DGT_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M

# --- Chunking ---
DGT_CHUNK_MAX_TOKENS=800
DGT_TOKENIZER_MODEL=nomic-ai/nomic-embed-text-v1.5
DGT_ENABLE_OCR=true

# --- Retrieval ---
# Search mode: vector, keyword, hybrid or rerank
DGT_SEARCH_MODE=rerank
DGT_RETRIEVAL_CANDIDATES=30
DGT_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
DGT_BM25_AVG_LEN=256
# Where fastembed keeps downloaded models (default: .cache/fastembed in your home folder)
# DGT_MODEL_CACHE_DIR=

# --- Storage ---
DGT_RAW_DATA_DIR=data/raw
DGT_QDRANT_PATH=data/index
DGT_COLLECTION_NAME=docs

# --- Logging (DEBUG, INFO, WARNING, ERROR) ---
DGT_LOG_LEVEL=INFO
